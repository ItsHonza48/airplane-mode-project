
#!/bin/bash
echo "Returning system back into normal operational mode..."

# 0. Zkontroluj že jsou nainstalované potřebné nástroje
for cmd in nmcli bluetoothctl; do
    if ! command -v "$cmd" &> /dev/null; then
        echo "Chyba: '$cmd' není nainstalován. Nainstaluj balíček network-manager / bluez a zkus to znovu." >&2
        exit 1
    fi
done

# 1. Unblock all wireless interfaces
sudo rfkill unblock all

# 2. Turn on wireless peripherals (Wi-Fi and Bluetooth)
nmcli networking on
sleep 1 #small pause to ensure the network manager has time to re-enable networking
bluetoothctl power on

# 3. Unblock Turbo Boost on Intel CPUs, jen pokud je to Intel a podporuje to intel_pstate
if grep -qi "GenuineIntel" /proc/cpuinfo && [ -f /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
    echo 0 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo > /dev/null
    echo "Turbo Boost re-enabled."
else
    echo "Turbo Boost step skipped: not an Intel CPU with intel_pstate support."
fi

echo "Normal mode activated. Wi-Fi, Bluetooth and TurboBoost are back online. Enjoy your vacation!"